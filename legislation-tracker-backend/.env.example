# Copy to .env and fill in values. Do not commit .env.

# Django
DEBUG=True
DJANGO_SECRET_KEY=change-me-use-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (use postgres when using docker-compose)
DATABASE_URL=postgres://legislation:legislation@localhost:5432/legislation
# Local SQLite (no docker):
# DATABASE_URL=sqlite:///./db.sqlite3

# Redis (Celery broker + cache)
REDIS_URL=redis://localhost:6379/0

# Congress.gov API
CONGRESS_API_KEY=your-congress-api-key

# GovInfo API
GOVINFO_API_KEY=your-govinfo-api-key

# S3 / MinIO (local dev: use MinIO from docker-compose)
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_S3_BUCKET_NAME=legislation-tracker-documents
# MinIO endpoint (local dev only; leave unset for real AWS)
AWS_S3_ENDPOINT_URL=http://localhost:9000

# CORS (comma-separated origins for the Next.js client)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
