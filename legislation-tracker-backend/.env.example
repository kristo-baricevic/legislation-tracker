# Copy to .env and fill in values. Do not commit .env.
# Postgres is the default; start it with: docker compose up -d

# Django
DEBUG=True
DJANGO_SECRET_KEY=change-me-use-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1

# Database — Postgres (default; use with docker compose)
DATABASE_URL=postgres://legislation:legislation@localhost:5432/legislation
# SQLite (no Docker):
# DATABASE_URL=sqlite:///./db.sqlite3

# Redis (Celery broker + cache)
REDIS_URL=redis://localhost:6379/0

# Congress.gov API
CONGRESS_API_KEY=your-congress-api-key
# Leave blank for automatic January 3 rollover. Set only for a backfill or
# emergency pin, and set it identically on API, worker, and Beat.
CURRENT_CONGRESS_OVERRIDE=

# GovInfo API
GOVINFO_API_KEY=your-govinfo-api-key

# Document storage
# True = files under local_media/ (no MinIO). False = S3/MinIO (start MinIO: docker compose up -d minio  →  :9000)
USE_LOCAL_DOCUMENT_STORAGE=True
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_STORAGE_BUCKET_NAME=legislation-tracker-documents
AWS_S3_ENDPOINT_URL=http://localhost:9000
DOCUMENT_DOWNLOAD_TIMEOUT_SECONDS=120
DOCUMENT_DOWNLOAD_MAX_BYTES=52428800
DOCUMENT_DOWNLOAD_SPOOL_MAX_BYTES=5242880
DOCUMENT_PDF_MAX_PAGES=1000
DOCUMENT_EXTRACTED_TEXT_MAX_CHARS=5000000

# CORS (comma-separated origins for the Next.js client)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AUTH_COOKIE_SAMESITE=Lax
AUTH_REGISTER_RATE=5/hour
AUTH_LOGIN_RATE=10/minute
AUTH_REFRESH_RATE=30/hour

# Optional user-owned AI bill enhancements (off by default). Generate a Fernet
# key with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LLM_ENHANCEMENTS_ENABLED=False
LLM_CREDENTIAL_ENCRYPTION_KEYS=primary:replace-with-generated-fernet-key
LLM_CREDENTIAL_ACTIVE_KEY_ID=primary
LLM_ENHANCEMENT_PROVIDER=openai
LLM_ENHANCEMENT_MODEL=gpt-5.6-luna
LLM_ENHANCEMENT_REASONING_EFFORT=none
LLM_ENHANCEMENT_MAX_REQUEST_BYTES=120000
LLM_ENHANCEMENT_MAX_ESTIMATED_INPUT_TOKENS=60000
LLM_ENHANCEMENT_MAX_OUTPUT_TOKENS=4000
LLM_ENHANCEMENT_PROVIDER_TIMEOUT_SECONDS=90
LLM_ENHANCEMENT_RUN_LEASE_SECONDS=180
LLM_ENHANCEMENT_CREATE_RATE=10/hour
LLM_ENHANCEMENT_VALIDATION_RATE=5/hour
# Local HTTP must be explicitly allowed before turning the feature on.
LLM_ENHANCEMENT_ALLOW_INSECURE_HTTP_IN_DEBUG=False
# Set only in a one-off shell used for the guarded evaluation command. Do not
# add this dedicated test key to normal API, worker, or Beat environments.
LLM_ENHANCEMENT_EVALUATION_API_KEY=
