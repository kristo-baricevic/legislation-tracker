{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://legislation-tracker.local/schemas/contract-v2-1.json",
  "title": "Deterministic legal NLP reader contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "title",
    "version_label",
    "extraction",
    "coverage_note",
    "orientation",
    "reader_stats",
    "section_groups",
    "line_items",
    "financial_items",
    "timeline_items",
    "requirements",
    "definitions",
    "applicability",
    "amendment_operations",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": "2.1-legal-nlp"},
    "title": {"type": "string", "minLength": 1, "maxLength": 500},
    "version_label": {"type": "string", "minLength": 1, "maxLength": 200},
    "extraction": {"$ref": "#/$defs/extraction"},
    "coverage_note": {"type": "string", "minLength": 1, "maxLength": 2000},
    "orientation": {"$ref": "#/$defs/orientation"},
    "reader_stats": {"$ref": "#/$defs/readerStats"},
    "section_groups": {
      "type": "array",
      "items": {"$ref": "#/$defs/sectionGroup"}
    },
    "line_items": {
      "type": "array",
      "items": {"$ref": "#/$defs/lineItem"}
    },
    "financial_items": {
      "type": "array",
      "items": {"$ref": "#/$defs/financialItem"}
    },
    "timeline_items": {
      "type": "array",
      "items": {"$ref": "#/$defs/timelineItem"}
    },
    "requirements": {
      "type": "array",
      "items": {"$ref": "#/$defs/requirement"}
    },
    "definitions": {
      "type": "array",
      "items": {"$ref": "#/$defs/definition"}
    },
    "applicability": {
      "type": "array",
      "items": {"$ref": "#/$defs/applicability"}
    },
    "amendment_operations": {
      "type": "array",
      "items": {"$ref": "#/$defs/amendment"}
    },
    "limitations": {
      "type": "array",
      "items": {"type": "string", "minLength": 1, "maxLength": 2000}
    }
  },
  "$defs": {
    "nullableString": {"type": ["string", "null"], "maxLength": 4000},
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[a-z][a-z0-9_-]*-[0-9]+(?:-[0-9]+)?$"
    },
    "referenceList": {
      "type": "array",
      "items": {"$ref": "#/$defs/identifier"},
      "uniqueItems": true
    },
    "evidencePaths": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1, "maxLength": 500},
      "uniqueItems": true
    },
    "sectionPathItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "label", "heading"],
      "properties": {
        "level": {
          "enum": [
            "division", "title", "subtitle", "chapter", "subchapter",
            "part", "subpart", "account", "subaccount", "subsubaccount",
            "subsubsubaccount", "article", "subdivision", "section",
            "appropriations_paragraph", "subsection", "paragraph",
            "subparagraph", "clause", "subclause", "item", "subitem"
          ]
        },
        "label": {"type": "string", "minLength": 1, "maxLength": 200},
        "heading": {"$ref": "#/$defs/nullableString"}
      }
    },
    "sectionPath": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/sectionPathItem"}
    },
    "fiscalYears": {
      "type": "array",
      "items": {"type": "integer", "minimum": 1000, "maximum": 9999}
    },
    "extraction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method", "parser_version", "extractor_version", "sections_seen",
        "sections_with_claims", "warnings"
      ],
      "properties": {
        "method": {"const": "federal-rules"},
        "parser_version": {"const": "2.1.0"},
        "extractor_version": {"const": "federal-rules-2.1.0"},
        "sections_seen": {"type": "integer", "minimum": 0},
        "sections_with_claims": {"type": "integer", "minimum": 0},
        "warnings": {
          "type": "array",
          "items": {"type": "string", "minLength": 1, "maxLength": 500}
        }
      }
    },
    "orientation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["purpose_clause", "purpose_line_item_id"],
      "properties": {
        "purpose_clause": {"$ref": "#/$defs/nullableString"},
        "purpose_line_item_id": {
          "anyOf": [{"$ref": "#/$defs/identifier"}, {"type": "null"}]
        }
      },
      "oneOf": [
        {
          "properties": {
            "purpose_clause": {"type": "null"},
            "purpose_line_item_id": {"type": "null"}
          }
        },
        {
          "properties": {
            "purpose_clause": {"type": "string", "minLength": 1, "maxLength": 4000},
            "purpose_line_item_id": {"$ref": "#/$defs/identifier"}
          }
        }
      ]
    },
    "readerStats": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "line_item_count", "financial_item_count", "timeline_item_count",
        "definition_item_count", "section_group_count"
      ],
      "properties": {
        "line_item_count": {"type": "integer", "minimum": 0},
        "financial_item_count": {"type": "integer", "minimum": 0},
        "timeline_item_count": {"type": "integer", "minimum": 0},
        "definition_item_count": {"type": "integer", "minimum": 0},
        "section_group_count": {"type": "integer", "minimum": 0}
      }
    },
    "sectionGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id", "section_path", "line_item_ids",
        "section_financial_refs", "section_timeline_refs"
      ],
      "properties": {
        "source_id": {"$ref": "#/$defs/identifier"},
        "section_path": {"$ref": "#/$defs/sectionPath"},
        "line_item_ids": {"$ref": "#/$defs/referenceList"},
        "section_financial_refs": {"$ref": "#/$defs/referenceList"},
        "section_timeline_refs": {"$ref": "#/$defs/referenceList"}
      }
    },
    "lineItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "source_id", "section_id", "section_path", "kind",
        "display_text", "actor", "action", "effect", "claim_refs",
        "exact_financial_refs", "timeline_refs", "definition_refs",
        "evidence_paths"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "source_id": {"$ref": "#/$defs/identifier"},
        "section_id": {"$ref": "#/$defs/identifier"},
        "section_path": {"$ref": "#/$defs/sectionPath"},
        "kind": {
          "enum": [
            "requirement", "prohibition", "permission", "amendment",
            "applicability", "financial", "timeline"
          ]
        },
        "display_text": {"type": "string", "minLength": 1, "maxLength": 4000},
        "actor": {"$ref": "#/$defs/nullableString"},
        "action": {"$ref": "#/$defs/nullableString"},
        "effect": {"$ref": "#/$defs/nullableString"},
        "claim_refs": {"$ref": "#/$defs/referenceList"},
        "exact_financial_refs": {"$ref": "#/$defs/referenceList"},
        "timeline_refs": {"$ref": "#/$defs/referenceList"},
        "definition_refs": {"$ref": "#/$defs/referenceList"},
        "evidence_paths": {"$ref": "#/$defs/evidencePaths"}
      }
    },
    "claimIdentity": {
      "type": "object",
      "required": [
        "id", "source_id", "section_id", "section_label", "section_path",
        "display_text", "evidence_paths"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "source_id": {"$ref": "#/$defs/identifier"},
        "section_id": {"$ref": "#/$defs/identifier"},
        "section_label": {"type": ["string", "null"], "maxLength": 200},
        "section_path": {"$ref": "#/$defs/sectionPath"},
        "display_text": {"type": "string", "minLength": 1, "maxLength": 4000},
        "evidence_paths": {"$ref": "#/$defs/evidencePaths"}
      }
    },
    "financialItem": {
      "allOf": [
        {"$ref": "#/$defs/claimIdentity"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id", "source_id", "section_id", "section_label", "section_path",
            "display_text", "evidence_paths", "financial_action", "direction",
            "amount", "amount_type", "currency", "fiscal_years", "purpose",
            "source_account", "destination_account"
          ],
          "properties": {
            "id": {"$ref": "#/$defs/identifier"},
            "source_id": {"$ref": "#/$defs/identifier"},
            "section_id": {"$ref": "#/$defs/identifier"},
            "section_label": {"type": ["string", "null"], "maxLength": 200},
            "section_path": {"$ref": "#/$defs/sectionPath"},
            "display_text": {"type": "string", "minLength": 1, "maxLength": 4000},
            "evidence_paths": {"$ref": "#/$defs/evidencePaths"},
            "financial_action": {
              "enum": [
                "appropriation", "authorization", "allocation", "transfer",
                "rescission", "reduction", "cancellation", "set_aside",
                "limitation", "other_explicit"
              ]
            },
            "direction": {"enum": ["increase", "decrease", "neutral_transfer", "limit"]},
            "amount": {
              "anyOf": [
                {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]{2})$", "maxLength": 100},
                {"type": "null"}
              ]
            },
            "amount_type": {"enum": ["specified", "such_sums", "percentage", "ceiling"]},
            "currency": {"enum": ["USD", null]},
            "fiscal_years": {"$ref": "#/$defs/fiscalYears"},
            "purpose": {"$ref": "#/$defs/nullableString"},
            "source_account": {"$ref": "#/$defs/nullableString"},
            "destination_account": {"$ref": "#/$defs/nullableString"}
          }
        }
      ]
    },
    "timelineItem": {
      "allOf": [
        {"$ref": "#/$defs/claimIdentity"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id", "source_id", "section_id", "section_label", "section_path",
            "display_text", "evidence_paths", "timeline_type", "date",
            "relative_value", "relative_unit", "trigger"
          ],
          "properties": {
            "id": {"$ref": "#/$defs/identifier"},
            "source_id": {"$ref": "#/$defs/identifier"},
            "section_id": {"$ref": "#/$defs/identifier"},
            "section_label": {"type": ["string", "null"], "maxLength": 200},
            "section_path": {"$ref": "#/$defs/sectionPath"},
            "display_text": {"type": "string", "minLength": 1, "maxLength": 4000},
            "evidence_paths": {"$ref": "#/$defs/evidencePaths"},
            "timeline_type": {"enum": ["absolute", "relative", "effective"]},
            "date": {
              "anyOf": [
                {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
                {"type": "null"}
              ]
            },
            "relative_value": {"type": ["integer", "null"], "minimum": 0},
            "relative_unit": {"enum": ["days", "months", "years", null]},
            "trigger": {"$ref": "#/$defs/nullableString"}
          }
        }
      ]
    },
    "requirement": {
      "allOf": [
        {"$ref": "#/$defs/claimIdentity"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id", "source_id", "section_id", "section_label", "section_path",
            "display_text", "evidence_paths", "modality", "actor", "action",
            "object", "conditions"
          ],
          "properties": {
            "id": {"$ref": "#/$defs/identifier"},
            "source_id": {"$ref": "#/$defs/identifier"},
            "section_id": {"$ref": "#/$defs/identifier"},
            "section_label": {"type": ["string", "null"], "maxLength": 200},
            "section_path": {"$ref": "#/$defs/sectionPath"},
            "display_text": {"type": "string", "minLength": 1, "maxLength": 4000},
            "evidence_paths": {"$ref": "#/$defs/evidencePaths"},
            "modality": {"enum": ["required", "prohibited", "permitted"]},
            "actor": {"type": "string", "minLength": 1, "maxLength": 1000},
            "action": {"type": "string", "minLength": 1, "maxLength": 4000},
            "object": {"$ref": "#/$defs/nullableString"},
            "conditions": {
              "type": "array",
              "items": {"type": "string", "minLength": 1, "maxLength": 2000}
            }
          }
        }
      ]
    },
    "definition": {
      "allOf": [
        {"$ref": "#/$defs/claimIdentity"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id", "source_id", "section_id", "section_label", "section_path",
            "display_text", "evidence_paths", "term", "definition",
            "definition_type"
          ],
          "properties": {
            "id": {"$ref": "#/$defs/identifier"},
            "source_id": {"$ref": "#/$defs/identifier"},
            "section_id": {"$ref": "#/$defs/identifier"},
            "section_label": {"type": ["string", "null"], "maxLength": 200},
            "section_path": {"$ref": "#/$defs/sectionPath"},
            "display_text": {"type": "string", "minLength": 1, "maxLength": 4000},
            "evidence_paths": {"$ref": "#/$defs/evidencePaths"},
            "term": {"type": "string", "minLength": 1, "maxLength": 1000},
            "definition": {"type": "string", "minLength": 1, "maxLength": 4000},
            "definition_type": {"enum": ["means", "includes", "excludes"]}
          }
        }
      ]
    },
    "applicability": {
      "allOf": [
        {"$ref": "#/$defs/claimIdentity"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id", "source_id", "section_id", "section_label", "section_path",
            "display_text", "evidence_paths", "subject", "scope",
            "applicability_type"
          ],
          "properties": {
            "id": {"$ref": "#/$defs/identifier"},
            "source_id": {"$ref": "#/$defs/identifier"},
            "section_id": {"$ref": "#/$defs/identifier"},
            "section_label": {"type": ["string", "null"], "maxLength": 200},
            "section_path": {"$ref": "#/$defs/sectionPath"},
            "display_text": {"type": "string", "minLength": 1, "maxLength": 4000},
            "evidence_paths": {"$ref": "#/$defs/evidencePaths"},
            "subject": {"type": "string", "minLength": 1, "maxLength": 2000},
            "scope": {"type": "string", "minLength": 1, "maxLength": 4000},
            "applicability_type": {"enum": ["applies", "does_not_apply", "eligible", "excluded"]}
          }
        }
      ]
    },
    "amendment": {
      "allOf": [
        {"$ref": "#/$defs/claimIdentity"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id", "source_id", "section_id", "section_label", "section_path",
            "display_text", "evidence_paths", "target", "operation",
            "removed_text", "inserted_text"
          ],
          "properties": {
            "id": {"$ref": "#/$defs/identifier"},
            "source_id": {"$ref": "#/$defs/identifier"},
            "section_id": {"$ref": "#/$defs/identifier"},
            "section_label": {"type": ["string", "null"], "maxLength": 200},
            "section_path": {"$ref": "#/$defs/sectionPath"},
            "display_text": {"type": "string", "minLength": 1, "maxLength": 4000},
            "evidence_paths": {"$ref": "#/$defs/evidencePaths"},
            "target": {"type": "string", "minLength": 1, "maxLength": 2000},
            "operation": {"enum": ["add", "insert", "strike", "strike_and_insert", "replace", "redesignate", "repeal", "amend"]},
            "removed_text": {"$ref": "#/$defs/nullableString"},
            "inserted_text": {"$ref": "#/$defs/nullableString"}
          }
        }
      ]
    }
  }
}
