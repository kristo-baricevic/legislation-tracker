{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://legislation-tracker.local/schemas/contract-v2.json",
  "title": "Deterministic legal NLP contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "title",
    "version_label",
    "extraction",
    "plain_summary",
    "key_provisions",
    "requirements",
    "funding_items",
    "timeline_items",
    "definitions",
    "applicability",
    "amendment_operations",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": "2.0-legal-nlp"},
    "title": {"type": "string"},
    "version_label": {"type": "string"},
    "extraction": {"$ref": "#/$defs/extraction"},
    "plain_summary": {"type": "string", "minLength": 1},
    "key_provisions": {"$ref": "#/$defs/keyProvisions"},
    "requirements": {"$ref": "#/$defs/requirements"},
    "funding_items": {"$ref": "#/$defs/fundingItems"},
    "timeline_items": {"$ref": "#/$defs/timelineItems"},
    "definitions": {"$ref": "#/$defs/definitions"},
    "applicability": {"$ref": "#/$defs/applicabilityItems"},
    "amendment_operations": {"$ref": "#/$defs/amendmentOperations"},
    "limitations": {
      "type": "array",
      "items": {"type": "string"},
      "maxItems": 100
    }
  },
  "$defs": {
    "nullableString": {"type": ["string", "null"]},
    "sectionLabel": {"type": ["string", "null"]},
    "stringList": {
      "type": "array",
      "items": {"type": "string"},
      "maxItems": 100
    },
    "extraction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "parser_version", "sections_seen", "sections_with_claims", "warnings"],
      "properties": {
        "method": {"const": "federal-rules"},
        "parser_version": {"const": "2.0.0"},
        "sections_seen": {"type": "integer", "minimum": 0},
        "sections_with_claims": {"type": "integer", "minimum": 0},
        "warnings": {"$ref": "#/$defs/stringList"}
      }
    },
    "keyProvisions": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "section_label", "heading", "text"],
        "properties": {
          "kind": {"enum": ["requirement", "funding", "timeline", "definition", "applicability", "amendment"]},
          "section_label": {"$ref": "#/$defs/sectionLabel"},
          "heading": {"$ref": "#/$defs/nullableString"},
          "text": {"type": "string", "minLength": 1}
        }
      }
    },
    "requirements": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["section_label", "display_text", "modality", "actor", "action", "object", "conditions"],
        "properties": {
          "section_label": {"$ref": "#/$defs/sectionLabel"},
          "display_text": {"type": "string", "minLength": 1},
          "modality": {"enum": ["required", "prohibited", "permitted"]},
          "actor": {"$ref": "#/$defs/nullableString"},
          "action": {"type": "string", "minLength": 1},
          "object": {"$ref": "#/$defs/nullableString"},
          "conditions": {"$ref": "#/$defs/stringList"}
        }
      }
    },
    "fundingItems": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["section_label", "display_text", "amount", "amount_type", "currency", "fiscal_years", "purpose"],
        "properties": {
          "section_label": {"$ref": "#/$defs/sectionLabel"},
          "display_text": {"type": "string", "minLength": 1},
          "amount": {"anyOf": [{"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]{2})?$"}, {"type": "null"}]},
          "amount_type": {"enum": ["exact", "up_to", "necessary", "unspecified"]},
          "currency": {"enum": ["USD", null]},
          "fiscal_years": {"$ref": "#/$defs/stringList"},
          "purpose": {"$ref": "#/$defs/nullableString"}
        }
      }
    },
    "timelineItems": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["section_label", "display_text", "timeline_type", "date", "relative_value", "relative_unit", "trigger"],
        "properties": {
          "section_label": {"$ref": "#/$defs/sectionLabel"},
          "display_text": {"type": "string", "minLength": 1},
          "timeline_type": {"enum": ["absolute", "relative", "fiscal_year", "unspecified"]},
          "date": {"anyOf": [{"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}, {"type": "null"}]},
          "relative_value": {"type": ["integer", "null"], "minimum": 0},
          "relative_unit": {"enum": ["days", "months", "years", null]},
          "trigger": {"$ref": "#/$defs/nullableString"}
        }
      }
    },
    "definitions": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["section_label", "display_text", "term", "definition", "definition_type"],
        "properties": {
          "section_label": {"$ref": "#/$defs/sectionLabel"},
          "display_text": {"type": "string", "minLength": 1},
          "term": {"type": "string", "minLength": 1},
          "definition": {"type": "string", "minLength": 1},
          "definition_type": {"enum": ["means", "includes", "excludes"]}
        }
      }
    },
    "applicabilityItems": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["section_label", "display_text", "subject", "scope", "applicability_type"],
        "properties": {
          "section_label": {"$ref": "#/$defs/sectionLabel"},
          "display_text": {"type": "string", "minLength": 1},
          "subject": {"type": "string", "minLength": 1},
          "scope": {"type": "string", "minLength": 1},
          "applicability_type": {"enum": ["applies", "does_not_apply", "effective"]}
        }
      }
    },
    "amendmentOperations": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["section_label", "display_text", "target", "operation", "removed_text", "inserted_text"],
        "properties": {
          "section_label": {"$ref": "#/$defs/sectionLabel"},
          "display_text": {"type": "string", "minLength": 1},
          "target": {"$ref": "#/$defs/nullableString"},
          "operation": {"enum": ["strike", "insert", "replace", "redesignate", "repeal"]},
          "removed_text": {"$ref": "#/$defs/nullableString"},
          "inserted_text": {"$ref": "#/$defs/nullableString"}
        }
      }
    }
  }
}
