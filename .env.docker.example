# Copy to .env.docker, fill in keys, then: rtk proxy bash scripts/docker-up.sh
DJANGO_SECRET_KEY=
CONGRESS_API_KEY=
FEC_API_KEY=
APP_PORT=13000
API_PORT=18001
# All workers start. Enable paid enhancements only with the original encryption
# key ring for an existing database. Never replace it with a new key ring.
# Explicitly choose True or False; preserve the existing app's setting.
LLM_ENHANCEMENTS_ENABLED=
LLM_CREDENTIAL_ENCRYPTION_KEYS=
LLM_CREDENTIAL_ACTIVE_KEY_ID=
# Local Docker uses HTTP on loopback; production must use HTTPS instead.
LLM_ENHANCEMENT_ALLOW_INSECURE_HTTP_IN_DEBUG=True
# Optional: adopt existing Docker volumes instead of creating a fresh database.
# EXISTING_VOLUMES=true
# POSTGRES_VOLUME=legislation-tracker-backend_postgres_data
# MINIO_VOLUME=legislation-tracker-backend_minio_data
# REDIS_VOLUME=existing-volume-name
