POSTGRES_USER=legislation
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=legislation
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=api.example.com
NEXT_PUBLIC_API_URL=https://api.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com,chrome-extension://replace-with-your-extension-id
CSRF_TRUSTED_ORIGINS=https://app.example.com
AUTH_COOKIE_SAMESITE=Lax
AUTH_REGISTER_RATE=5/hour
AUTH_LOGIN_RATE=10/minute
AUTH_REFRESH_RATE=30/hour
CONGRESS_API_KEY=replace-with-congress-api-key
USE_LOCAL_DOCUMENT_STORAGE=False
AWS_ACCESS_KEY_ID=replace-with-storage-access-key
AWS_SECRET_ACCESS_KEY=replace-with-storage-secret
AWS_STORAGE_BUCKET_NAME=legislation-tracker-documents
AWS_S3_REGION_NAME=us-east-1
# AWS_S3_ENDPOINT_URL=https://s3.example.com

# Deterministic reader-first bill contracts. Keep the 2.1 writer disabled until
# the compatible API and client readers are deployed and verified. Persisted
# 2.1 contracts remain readable when this is False.
LEGAL_NLP_V21_WRITE_ENABLED=False

# Optional user-owned AI bill enhancements. Keep disabled until TLS ingress,
# log redaction, migrations, worker, Beat, and the human evaluation gate pass.
LLM_ENHANCEMENTS_ENABLED=False
LLM_CREDENTIAL_ENCRYPTION_KEYS=primary:replace-with-generated-fernet-key
LLM_CREDENTIAL_ACTIVE_KEY_ID=primary
LLM_ENHANCEMENT_PROVIDER=openai
LLM_ENHANCEMENT_MODEL=gpt-5.6-luna
LLM_ENHANCEMENT_REASONING_EFFORT=none
LLM_ENHANCEMENT_MAX_REQUEST_BYTES=120000
LLM_ENHANCEMENT_MAX_ESTIMATED_INPUT_TOKENS=60000
LLM_ENHANCEMENT_MAX_OUTPUT_TOKENS=4000
LLM_ENHANCEMENT_PROVIDER_TIMEOUT_SECONDS=90
LLM_ENHANCEMENT_RUN_LEASE_SECONDS=180
LLM_ENHANCEMENT_CREATE_RATE=10/hour
LLM_ENHANCEMENT_VALIDATION_RATE=5/hour
LLM_ENHANCEMENT_PRODUCTION_TLS_CONFIRMED=False
LLM_ENHANCEMENT_SECRET_LOG_REDACTION_CONFIRMED=False
